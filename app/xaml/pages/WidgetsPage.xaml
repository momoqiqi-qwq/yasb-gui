<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="40,24,40,24">
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="16">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="Widgets" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectBarLabel" Text="Select bar" VerticalAlignment="Center"/>
                        <ComboBox x:Name="BarSelector" MinWidth="180"/>
                        <Button x:Name="AddWidgetButton">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock x:Name="AddWidgetText" Text="Add Widget" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="WidgetFilter" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="FilterCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <CommandBar.Content>
                        <TextBlock x:Name="SelectionCount" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    </CommandBar.Content>
                    <AppBarButton x:Name="SelectVisibleButton" Icon="SelectAll"/>
                    <AppBarButton x:Name="ClearSelectionButton" Icon="ClearSelection"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Name="BatchDuplicateButton" Icon="Copy"/>
                    <AppBarButton x:Name="BatchDisableButton" Icon="Cancel"/>
                    <AppBarButton x:Name="BatchMoveButton" Icon="MoveToFolder"/>
                </CommandBar>
                <TextBlock x:Name="BatchHint" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <InfoBar x:Name="BatchStatus" IsOpen="False" IsClosable="True"/>
                <StackPanel x:Name="SectionsPanel" Spacing="4"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
